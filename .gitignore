# Purpose: Keep generated build and local env artifacts out of the semantic-layer repo.
# Inputs: Developer tools, Haskell builds, Python caches, and local env files.
# Outputs: Cleaner git diffs and safer snapshot branches.
# Next stage: Git operations can remove already-tracked generated artifacts.

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local environment files
.env
.env.*
!.env.example

# macOS
.DS_Store

# Haskell / Cabal build outputs
dist/
dist-newstyle/
services/ontology-hs/dist/
services/ontology-hs/dist-newstyle/
