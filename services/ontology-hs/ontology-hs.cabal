cabal-version:      2.4
name:               ontology-hs
version:            0.1.0.0
build-type:         Simple

executable ontology-hs
  main-is:          Main.hs
  hs-source-dirs:   app, src
  default-language: GHC2024
  ghc-options:      -Wall
  other-modules:
      GroundedPlanning.Compile
    , GroundedPlanning.Compile.PlanBuilder
    , GroundedPlanning.Compile.Sql.Aggregate
    , GroundedPlanning.Compile.Sql.Common
    , GroundedPlanning.Compile.Sql.Comparison
    , GroundedPlanning.Compile.Sql.Find
    , GroundedPlanning.Compile.Sql.Object
    , GroundedPlanning.Compile.Sql.Ranking
    , GroundedPlanning.Compile.Sql.Trend
    , GroundedPlanning.Plan
    , GroundedPlanning.Resolve
    , GroundedPlanning.Resolve.Common
    , GroundedPlanning.Resolve.Common.Context
    , GroundedPlanning.Resolve.Common.Dimensions
    , GroundedPlanning.Resolve.Common.DisplayMetadata
    , GroundedPlanning.Resolve.Common.Filters
    , GroundedPlanning.Resolve.Common.LinkedFilters
    , GroundedPlanning.Resolve.Common.Metrics
    , GroundedPlanning.Resolve.Common.Ontology
    , GroundedPlanning.Resolve.Common.Trend
    , GroundedPlanning.Resolve.Common.Types
    , GroundedPlanning.Resolve.Common.ValueCanonicalization
    , GroundedPlanning.Resolve.Rank
    , GroundedPlanning.Resolve.Trend
    , GroundedPlanning.Resolve.Object
    , GroundedPlanning.Resolve.Compare
    , GroundedPlanning.Resolve.Aggregate
    , GroundedPlanning.Resolve.Find
    , GroundedPlanning.Validation
    , GroundedPlanning.Validation.Common
    , GroundedPlanning.Validation.Common.Comparison
    , GroundedPlanning.Validation.Common.Dimensions
    , GroundedPlanning.Validation.Common.Filters
    , GroundedPlanning.Validation.Common.LinkedFilters
    , GroundedPlanning.Validation.Common.Metrics
    , GroundedPlanning.Validation.Common.Ontology
    , GroundedPlanning.Validation.Common.Orders
    , GroundedPlanning.Validation.Common.Trend
    , GroundedPlanning.Validation.Common.Types
    , GroundedPlanning.Validation.Rank
    , GroundedPlanning.Validation.Trend
    , GroundedPlanning.Validation.Object
    , GroundedPlanning.Validation.Compare
    , GroundedPlanning.Validation.Aggregate
    , GroundedPlanning.Validation.Find
    , OntologyLayer.Graph
    , OntologyLayer.Load
    , OntologyLayer.Types
    , OntologyLayer.Validation
    , QueryModel.IR
    , QueryModel.SemanticDraft
    , QueryModel.SemanticDraft.Aggregate
    , QueryModel.SemanticDraft.Compare
    , QueryModel.SemanticDraft.FilterGrounding
    , QueryModel.SemanticDraft.Filters
    , QueryModel.SemanticDraft.Find
    , QueryModel.SemanticDraft.Match
    , QueryModel.SemanticDraft.Normalize
    , QueryModel.SemanticDraft.Object
    , QueryModel.SemanticDraft.Rank
    , QueryModel.SemanticDraft.Trend
    , QueryModel.SemanticDraft.Types
  build-depends:
      base >= 4.20 && < 5
    , aeson
    , bytestring
    , containers
    , text
    , yaml
