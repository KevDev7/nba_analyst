cabal-version:      2.4
name:               ontology-hs
version:            0.1.0.0
build-type:         Simple

executable ontology-hs
  main-is:          Main.hs
  hs-source-dirs:   app, src
  default-language: GHC2024
  ghc-options:      -Wall
  other-modules:
      GroundedPlanning.Compile
    , GroundedPlanning.Plan
    , GroundedPlanning.Resolve
    , GroundedPlanning.Resolve.Common
    , GroundedPlanning.Resolve.Rank
    , GroundedPlanning.Resolve.Trend
    , GroundedPlanning.Resolve.Object
    , GroundedPlanning.Resolve.Compare
    , GroundedPlanning.Resolve.Aggregate
    , GroundedPlanning.Resolve.Find
    , GroundedPlanning.Validation
    , GroundedPlanning.Validation.Common
    , GroundedPlanning.Validation.Rank
    , GroundedPlanning.Validation.Trend
    , GroundedPlanning.Validation.Object
    , GroundedPlanning.Validation.Compare
    , GroundedPlanning.Validation.Aggregate
    , GroundedPlanning.Validation.Find
    , OntologyLayer.Graph
    , OntologyLayer.Load
    , OntologyLayer.Types
    , OntologyLayer.Validation
    , QueryModel.IR
    , QueryModel.SemanticDraft
  build-depends:
      base >= 4.20 && < 5
    , aeson
    , bytestring
    , containers
    , text
    , yaml
