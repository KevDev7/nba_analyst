# Purpose: Root local configuration for the semantic CLI and upcoming LLM interpretation layer.
# Fill these values in .env for local development. Keep real secrets out of git.

# Existing warehouse / snapshot config
ATHENA_DATABASE=semantic_gold
ATHENA_OUTPUT_LOCATION=s3://nba-analytics-lakehouse-dev/athena-results/
ATHENA_WORKGROUP=primary
ATHENA_CATALOG=AwsDataCatalog
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=

# Slice 10 LLM interpreter config
LLM_INTERPRETER_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview
LLM_INTERPRETER_ATTEMPTS_PER_MODEL=1
LLM_INTERPRETER_TEMPERATURE=0

# Production deploy runtime config
NBA_ONTOLOGY_PLANNER_BIN=
NBA_DISABLE_SNAPSHOT_REBUILD=
NBA_ALLOWED_ORIGINS=
NBA_ENABLE_PUBLIC_DEBUG=
NBA_MAX_QUESTION_CHARS=250

# Governed model orchestration gates. Keep off in production unless explicitly beta-enabled.
NBA_ENABLE_MODEL_ORCHESTRATOR=0
NBA_MODEL_ORCHESTRATOR_DRY_RUN=0
NBA_ENABLE_MODEL_TOOL_LOOP=0
NBA_ENABLE_MODEL_ANSWER_COMPOSER=0

# Python code sandbox gates. Keep off by default.
NBA_ENABLE_PYTHON_CODE_SANDBOX=0
NBA_PYTHON_CODE_SANDBOX_BACKEND=local_beta
E2B_API_KEY=
NBA_RUN_LIVE_E2B_TESTS=0

# Browser UI deploy config
PUBLIC_API_BASE_URL=
PUBLIC_MAX_QUESTION_CHARS=250
